# Required for a zero-key local run
MOCK_MODE=1
PORT=8787
VITE_API_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173
# Optional local override; defaults to ../rubrics when the API runs from /api
RUBRICS_DIR=
# Optional local JSON-store directory; defaults to api/.data
LOCAL_DATA_DIR=.data

# Required only when MOCK_MODE is not 1
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_SESSIONS_TABLE=viva-teach-back-sessions
AWS_CREDENTIALS_TABLE=viva-teach-back-credentials
AWS_S3_BUCKET=viva-teach-back-web
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# HMAC-SHA256 secret for Skill Page seals (required when MOCK_MODE is off)
PAGE_SECRET=

# Admin API key for GET /api/admin/costs
ADMIN_KEY=
# Per-session cost cap in INR (default 25); 0 = no cap
COST_CAP_INR=25
# Hard max session duration in seconds (default 600)
MAX_SESSION_DURATION_SECONDS=600
# Max challenge upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# For DynamoStore tests (DynamoDB Local)
DYNAMODB_LOCAL_ENDPOINT=http://localhost:8000

# Optional external Tryb practice game URL (leave blank until configured)
VITE_TRYB_PRACTICE_URL=
# Optional outbound Devnovate portfolio/opportunity URL (leave blank until configured)
VITE_DEVNOVATE_URL=

# Ed25519 Skill Passport Signing (server-side only; MOCK_MODE generates a local dev keypair)
PASSPORT_ISSUER=https://prooffolio.xyz
PASSPORT_PUBLIC_DOMAIN=
ED25519_KEY_ID=
ED25519_PRIVATE_KEY_PEM=
ED25519_PUBLIC_KEY_PEM=
